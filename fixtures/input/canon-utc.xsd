<?xml version="1.0"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="r">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="day" type="xs:date" maxOccurs="unbounded"/>
        <xs:element name="ym" type="xs:gYearMonth" maxOccurs="unbounded"/>
        <xs:element name="y" type="xs:gYear" maxOccurs="unbounded"/>
        <xs:element name="md" type="xs:gMonthDay" maxOccurs="unbounded"/>
        <xs:element name="d" type="xs:gDay" maxOccurs="unbounded"/>
        <xs:element name="m" type="xs:gMonth" maxOccurs="unbounded"/>
        <xs:element name="t" type="xs:time" maxOccurs="unbounded"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
