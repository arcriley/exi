<?xml version="1.0" encoding="UTF-8"?>
<!--
  EXIG 1 (draft): the vocabulary of EXI grammar documents.

  An EXIG document carries the schema-informed grammars EXI derives from a schema
  (EXI 1.0 §8.5), so a receiver needs an EXI decoder and this schema, and no XSD compiler.
  An .exig file is an EXIG document encoded as EXI: schema-informed under this schema,
  strict, byte-aligned, with the options in the header.

  Numbers are positions: simple types, types and elements are numbered from 0 in document
  order, and states from 0 within their type. Everything is listed in a canonical order, so
  equal grammars give equal documents:
    - types: named ones sorted by URI then local name, then anonymous ones in the order a
      depth-first walk first reaches them (global elements sorted by local name then URI,
      then the named types; within a type, states in order, productions in order);
    - elements and simple types: in the order the same walk first reaches them;
    - states: in breadth-first order from state 0, following productions in order;
    - productions: in event-code order (EXI §8.5.4.3).
  Only strict grammars are written: a receiver adds the productions of non-strict streams
  as EXI §8.5.4.4 specifies.

  The namespace is a placeholder until one is assigned.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns:g="urn:exig:draft-1" targetNamespace="urn:exig:draft-1"
           elementFormDefault="qualified">

  <xs:element name="grammars">
    <xs:complexType>
      <xs:sequence>
        <!-- The initial string table beyond the entries EXI always has (EXI §7.3.1, App. D). -->
        <xs:element name="strings" type="g:Strings"/>
        <xs:element name="simpleType" type="g:SimpleType" minOccurs="0" maxOccurs="unbounded"/>
        <xs:element name="type" type="g:Type" maxOccurs="unbounded"/>
        <xs:element name="element" type="g:Element" minOccurs="0" maxOccurs="unbounded"/>
        <!-- The global element declarations: the SE(qname) productions of DocContent. -->
        <xs:element name="global" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded"/>
      </xs:sequence>
      <!-- The schemaId the grammars are published under (EXI §5.4), when there is one. -->
      <xs:attribute name="schemaId" type="xs:string"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="Strings">
    <xs:sequence>
      <!-- URIs in table order; for each, its local names in table order. -->
      <xs:element name="uri" minOccurs="0" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="local" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
          </xs:sequence>
          <xs:attribute name="value" type="xs:string" use="required"/>
        </xs:complexType>
      </xs:element>
    </xs:sequence>
  </xs:complexType>

  <!-- How a simple type's values are coded (EXI §7.1, §7.2): only what changes the coding. -->
  <xs:complexType name="SimpleType">
    <xs:sequence>
      <!-- Enumeration values, in ordinal order. -->
      <xs:element name="enumeration" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <!-- A restricted character set (EXI §7.1.10.1): its characters, sorted. -->
      <xs:element name="charset" type="xs:string" minOccurs="0"/>
    </xs:sequence>
    <xs:attribute name="representation" type="g:Representation" use="required"/>
    <!-- boundedInteger -->
    <xs:attribute name="minInclusive" type="xs:long"/>
    <xs:attribute name="maxInclusive" type="xs:long"/>
    <!-- list: the item type; enumeration: the type its values are of. -->
    <xs:attribute name="itemType" type="xs:unsignedInt"/>
    <xs:attribute name="base" type="xs:unsignedInt"/>
  </xs:complexType>

  <xs:simpleType name="Representation">
    <xs:restriction base="xs:string">
      <xs:enumeration value="string"/>
      <xs:enumeration value="boolean"/>
      <xs:enumeration value="booleanPattern"/>
      <xs:enumeration value="integer"/>
      <xs:enumeration value="unsignedInteger"/>
      <xs:enumeration value="boundedInteger"/>
      <xs:enumeration value="decimal"/>
      <xs:enumeration value="float"/>
      <xs:enumeration value="hexBinary"/>
      <xs:enumeration value="base64Binary"/>
      <xs:enumeration value="gYear"/>
      <xs:enumeration value="gYearMonth"/>
      <xs:enumeration value="date"/>
      <xs:enumeration value="dateTime"/>
      <xs:enumeration value="gMonth"/>
      <xs:enumeration value="gMonthDay"/>
      <xs:enumeration value="gDay"/>
      <xs:enumeration value="time"/>
      <xs:enumeration value="list"/>
      <xs:enumeration value="enumeration"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- A type grammar (EXI §8.5.4.1.3): its states, and the xsi:type targets it allows. -->
  <xs:complexType name="Type">
    <xs:sequence>
      <xs:element name="state" maxOccurs="unbounded">
        <xs:complexType>
          <xs:sequence>
            <xs:element name="production" type="g:Production" maxOccurs="unbounded"/>
          </xs:sequence>
        </xs:complexType>
      </xs:element>
      <!-- Named types other than this one that xsi:type may name for it. -->
      <xs:element name="cast" type="xs:unsignedInt" minOccurs="0" maxOccurs="unbounded"/>
    </xs:sequence>
    <!-- A named type's name. -->
    <xs:attribute name="uri" type="xs:string"/>
    <xs:attribute name="local" type="xs:string"/>
    <!-- Strict adds AT(xsi:type) to elements of this type (EXI §8.5.4.4.1). -->
    <xs:attribute name="castable" type="xs:boolean"/>
  </xs:complexType>

  <xs:complexType name="Production">
    <xs:attribute name="event" type="g:Event" use="required"/>
    <!-- AT: the attribute's name; ATuri and SEuri: the URI. -->
    <xs:attribute name="uri" type="xs:string"/>
    <xs:attribute name="local" type="xs:string"/>
    <!-- AT and CH: the value's simple type. -->
    <xs:attribute name="type" type="xs:unsignedInt"/>
    <!-- SE: the element declaration. -->
    <xs:attribute name="element" type="xs:unsignedInt"/>
    <!-- Every event but EE: the state that follows. -->
    <xs:attribute name="next" type="xs:unsignedInt"/>
  </xs:complexType>

  <xs:simpleType name="Event">
    <xs:restriction base="xs:string">
      <xs:enumeration value="AT"/>
      <xs:enumeration value="ATuri"/>
      <xs:enumeration value="ATany"/>
      <xs:enumeration value="SE"/>
      <xs:enumeration value="SEuri"/>
      <xs:enumeration value="SEany"/>
      <xs:enumeration value="EE"/>
      <xs:enumeration value="CH"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- An element declaration: its grammar is its type's, with xsi:nil when nillable. -->
  <xs:complexType name="Element">
    <xs:attribute name="uri" type="xs:string" use="required"/>
    <xs:attribute name="local" type="xs:string" use="required"/>
    <xs:attribute name="type" type="xs:unsignedInt" use="required"/>
    <xs:attribute name="nillable" type="xs:boolean"/>
  </xs:complexType>
</xs:schema>
