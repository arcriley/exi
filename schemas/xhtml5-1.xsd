      <xs:attribute name="src" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Select">
    <xs:complexContent mixed="true"><xs:extension base="Flow">
      <xs:attribute name="name" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Source">
    <xs:complexContent><xs:extension base="Void">
      <xs:attribute name="media" type="xs:string"/>
      <xs:attribute name="sizes" type="xs:string"/>
      <xs:attribute name="src" type="xs:string"/>
      <xs:attribute name="srcset" type="xs:string"/>
      <xs:attribute name="type" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Td">
    <xs:complexContent mixed="true"><xs:extension base="Flow">
      <xs:attribute name="colspan" type="xs:string"/>
      <xs:attribute name="rowspan" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Textarea">
    <xs:simpleContent><xs:extension base="Text">
      <xs:attribute name="cols" type="xs:string"/>
      <xs:attribute name="name" type="xs:string"/>
      <xs:attribute name="placeholder" type="xs:string"/>
      <xs:attribute name="rows" type="xs:string"/>
    </xs:extension></xs:simpleContent>
  </xs:complexType>
  <xs:complexType name="Th">
    <xs:complexContent mixed="true"><xs:extension base="Flow">
      <xs:attribute name="colspan" type="xs:string"/>
      <xs:attribute name="rowspan" type="xs:string"/>
      <xs:attribute name="scope" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Time">
    <xs:complexContent mixed="true"><xs:extension base="Phrasing">
      <xs:attribute name="datetime" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>
  <xs:complexType name="Video">
    <xs:complexContent mixed="true"><xs:extension base="Flow">
      <xs:attribute name="autoplay" type="xs:string"/>
      <xs:attribute name="controls" type="xs:string"/>
      <xs:attribute name="loop" type="xs:string"/>
      <xs:attribute name="muted" type="xs:string"/>
      <xs:attribute name="playsinline" type="xs:string"/>
      <xs:attribute name="poster" type="xs:string"/>
      <xs:attribute name="src" type="xs:string"/>
    </xs:extension></xs:complexContent>
  </xs:complexType>

