<?xml version="1.0" encoding="UTF-8"?>
<!-- The XHTML5 coding schema, version 1: urn:libexi:xhtml5:1 (libexi Appendix D).

     A schema for coding, not validation: it gives short event codes to the names most
     pages use. Used with strict off, so a page with anything else still encodes.

     Frozen: once released this file never changes; any change, even a reordering,
     is a new version. The SHA-256 of its .exig is pinned in tests/xhtml5.rs.

     Rules (Appendix D.5):
     - every HTML element is a global element in the XHTML namespace;
     - content types are mixed with an unbounded choice: Flow (every element),
       Phrasing, Text (title, script, style, textarea) and Void; Html and Head;
     - content-model rules are not encoded: html5ever has fixed the structure;
     - global attributes in one group, element attributes on derived types, every
       attribute value xs:string, and xs:anyAttribute for data-*, aria-* and the rest;
     - SVG and MathML through xs:any, learned per document. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns="http://www.w3.org/1999/xhtml"
           targetNamespace="http://www.w3.org/1999/xhtml" elementFormDefault="qualified">

  <xs:attributeGroup name="global">
    <xs:attribute name="class" type="xs:string"/>
    <xs:attribute name="dir" type="xs:string"/>
    <xs:attribute name="hidden" type="xs:string"/>
    <xs:attribute name="id" type="xs:string"/>
    <xs:attribute name="lang" type="xs:string"/>
    <xs:attribute name="role" type="xs:string"/>
    <xs:attribute name="style" type="xs:string"/>
    <xs:attribute name="tabindex" type="xs:string"/>
    <xs:attribute name="title" type="xs:string"/>
    <xs:anyAttribute namespace="##any" processContents="lax"/>
  </xs:attributeGroup>

