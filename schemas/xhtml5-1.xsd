  <xs:complexType name="Script">
    <xs:simpleContent><xs:extension base="Text">
      <xs:attribute name="async" type="xs:string"/>
      <xs:attribute name="crossorigin" type="xs:string"/>
      <xs:attribute name="defer" type="xs:string"/>
